# The backend also reads the project-root .env, so OPENAI_API_KEY can live there.
OPENAI_API_KEY=sk-...
# OPENAI_CHAT_MODEL=gpt-4o-mini

# Product data: the "Alkem Product list" Google Sheet.
# If the sheet is private, share it with a service account and point to its JSON key:
# GOOGLE_SERVICE_ACCOUNT_FILE=backend/service-account.json
# GOOGLE_SHEET_ID=1xvDjZr-PGSxsNLOl7IrpO__YWWlODm6dvkTvyf2VLjQ
# GOOGLE_SHEET_GID=1204725225
# Or sign in as a Google user (OAuth): set these, then open http://localhost:8000/oauth/google/start
# once. Add http://localhost:8000/oauth/callback as an authorised redirect URI on the client.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_TOKEN_FILE=backend/google-token.json
# Or use a local CSV export instead:
# PRODUCTS_CSV_PATH=backend/data/products.csv

# Human escalation → Microsoft Teams channel (Workflows "Post to a channel when a webhook request is received")
TEAMS_WEBHOOK_URL=

# Optional Supabase persistence (conversations, messages, customers, escalations).
# Use the service-role key here (server-side only); the anon key needs RLS insert/update policies.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_KEY=

# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://www.example.com
