# Chat backend (FastAPI, see backend/). Defaults to /api/chat, proxied to localhost:8000 in dev.
# Set this for production builds if the backend is hosted elsewhere.
# VITE_CHAT_API_URL=https://chat-api.example.com/api/chat
# Chat backend settings (TEAMS_WEBHOOK_URL, Google Sheet, ...) are listed in backend/.env.example

# Voice chat (OpenAI Realtime, speech-to-speech) — server-only, never prefix with VITE_
OPENAI_API_KEY=sk-...
# Optional overrides
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# OPENAI_REALTIME_VOICE=marin
# OPENAI_TRANSCRIBE_MODEL=whisper-1
# ALLOWED_ORIGINS=https://www.example.com,https://example.com
